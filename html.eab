<!--time-->
<div class="time">
<h1 class="time-title">⏰ Current Time in Haridwar, India ⏰</h1>
<div id="timeDisplay" class="time-display"></div>
</div>
<!-- Scripts -->

 <script>
// Counter Animation
const counters = document.querySelectorAll('.counter');
counters.forEach(counter => {
counter.innerText = '0';
const updateCounter = () => {
const target = +counter.getAttribute('data-target');
const count = +counter.innerText;
const increment = target / 200; // Adjust speed here
if (count < target) {
counter.innerText = Math.ceil(count + increment);
setTimeout(updateCounter, 10);
} else {
counter.innerText = target;
}
};
updateCounter();
});

// Time Display
function updateTime() {
const options = { timeZone: 'Asia/Kolkata', hour: '2-digit', minute: '2-digit', second: '2-digit' };
const formatter = new Intl.DateTimeFormat([], options);
document.getElementById('timeDisplay').innerText = formatter.format(new Date());
}
setInterval(updateTime, 1000);
updateTime(); 





 </script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
